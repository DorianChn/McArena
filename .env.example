# ============================================================
# McArena 环境变量示例（复制为 .env 后填写；.env 已被 .gitignore 忽略）
# 严禁把真实 Token 提交到任何仓库文件
# ============================================================

# ---- 数据模式（MCD_MCP_MODE）----
# mock   = 开发用模拟数据（默认；界面会明确标注「模拟数据」，禁止冒充官方数据）
# replay = 仓内官方数据快照回放（无需 Token；快照由阶段02采集生成）
# live   = 实时查询麦当劳官方 MCP Server（需 MCD_MCP_TOKEN；阶段02启用）
MCD_MCP_MODE=mock

# ---- 麦当劳官方 MCP ----
# 从 https://open.mcd.cn/mcp 控制台申请（手机号登录 → 激活），仅写入本机 .env
MCD_MCP_TOKEN=
# 官方接入地址（一般无需修改）
MCD_MCP_URL=https://mcp.mcd.cn
# 客户端每分钟最大请求数（官方上限 600，默认保守取 300）
MCD_MCP_MAX_RPM=300
# 请求超时（毫秒）
MCD_MCP_TIMEOUT_MS=15000
# 本项目默认禁止一切下单写操作（create-order 等），仅调试用途才可开启
MCD_ALLOW_WRITE_TOOLS=false

# ---- API 服务 ----
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=*
