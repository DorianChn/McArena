{
  "name": "mcarena",
  "version": "0.1.0",
  "private": true,
  "description": "McArena - McDonald's MCP based dual-agent ordering decision arena (麦门 AI 竞技场)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @mcarena/api",
    "dev:web": "npm run dev -w @mcarena/web",
    "build": "npm run typecheck && npm run build -w @mcarena/api && npm run build -w @mcarena/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "start": "npm run build && node apps/api/dist/server.js",
    "demo": "npm run demo -w @mcarena/arena-core",
    "bench": "npm run bench -w @mcarena/arena-core"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.1.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.4"
  }
}
